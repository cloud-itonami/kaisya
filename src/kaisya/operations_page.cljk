(ns kaisya.operations-page
  "Public shell for private, initially empty company records. The browser app
  renders all returned records only after an owner passkey session is verified."
  (:require [cloud-kotoba-dds.shell :as shell]
            [cloud-kotoba-dds.status :as status]
            [cloud-kotoba-dds.theme :as dds-theme]
            [jp-go-dds.core :as dds]
            [jp-go-dds.page :as dds-page]
            [kotoba.io :as io]))

(defn section [{:keys [title id]} content]
  [:section {:class "kaisya-section" :id id}
   [:h2 title] content])

(defn panel [content]
  (into [:div {:class "kaisya-panel"}] content))

(defn field [id label type]
  [:label {:for id} label
   [:input {:id id :name id :type type :required true :autocomplete "off"}]])

(defn view []
  [:div {:class "kaisya-operations"}
   (shell/topbar {:section [:span "kaisya"]
                  :actions [[:span "Gftd Japan"]]})
   [:main {:id "main" :class "kaisya-operations__main"}
    [:h1 "会計・勤怠・台帳"]
    [:p "空の会社環境から記録を始めます。"]
   (section {:title "パスキー" :wide true :id "auth"}
    (panel
     [(status/line {:id "auth-status" :label "ログイン状態"})
      [:div {:class "ks-actions"}
       (dds/button "パスキーでログイン" {:id "login-passkey"})
       (dds/button "新しいパスキーを登録" {:id "register-passkey" :type :outline})]
      [:p {:id "credential-id" :class "hig-caption1 ks-muted"}]
      [:details {:class "ks-muted"}
       [:summary "新しいパスキーについて"]
       [:p "登録後、所有者の確認を経て会社データへアクセスできます。"]]]))
   [:div {:id "owner-workspace" :hidden true}
    [:nav {:class "kaisya-task-nav" :aria-label "会社の作業"}
     [:a {:href "#journal"} "仕訳"]
     [:a {:href "#attendance"} "勤怠"]
     [:a {:href "#register"} "台帳"]]
   (section {:title "記録の状態" :wide true :id "summary"}
    (panel [[:p {:id "record-summary"} "読み込み中…"]
                 [:div {:class "ks-actions"}
                  (dds/button "更新" {:id "refresh-records" :type :outline})
                  (dds/button "ログアウト" {:id "logout" :type :text})]]))
    (section {:title "仕訳" :wide true :id "journal"}
     (panel
      [[:form {:id "journal-form"}
        (field "journal-date" "取引日" "date")
        (field "journal-source" "証憑・取引番号" "text")
        (field "journal-debit" "借方科目" "text")
        (field "journal-credit" "貸方科目" "text")
        (field "journal-amount" "金額（円）" "number")
        (dds/button "貸借を確認して記帳" {:submit? true})]
       (status/line {:id "journal-result" :label "記帳結果"})
       [:details [:summary "勘定科目別残高"] [:ul {:id "balance-list"}]]
       [:details [:summary "記帳済み仕訳"] [:ul {:id "journal-list"}]]]))
    (section {:title "勤怠" :wide true :id "attendance"}
     (panel
      [[:form {:id "time-form"}
        (field "time-worker" "従業員ID" "text")
        [:label {:for "time-direction"} "打刻"
         [:select {:id "time-direction" :name "time-direction"}
          [:option {:value "in"} "出勤"]
          [:option {:value "out"} "退勤"]]]
        (dds/button "現在時刻で打刻" {:submit? true})]
       (status/line {:id "time-result" :label "打刻結果"})
       [:details [:summary "打刻履歴"] [:ul {:id "time-list"}]]]))
    (section {:title "台帳" :wide true :id "register"}
     (panel
      [[:form {:id "register-form"}
        [:label {:for "register-type"} "台帳の種類"
         [:select {:id "register-type" :name "register-type"}
          [:option {:value "employee"} "従業員"]
          [:option {:value "asset"} "資産"]
          [:option {:value "obligation"} "債務・未払"]
          [:option {:value "document"} "文書"]
          [:option {:value "wage"} "賃金"]]]
        (field "register-subject" "対象ID" "text")
        (field "register-evidence" "証拠・根拠ID" "text")
        [:label {:for "register-value"} "記録内容"
         [:textarea {:id "register-value" :name "register-value" :required true}]]
        (dds/button "台帳に追記" {:submit? true})]
       (status/line {:id "register-result" :label "台帳の保存結果"})
       [:details [:summary "台帳履歴"] [:ul {:id "register-list"}]]]))]]])

(def app-css
  (str
       ".kaisya-operations__main{max-width:72rem;margin:auto;padding:var(--hig-spacing-5);padding-bottom:calc(var(--hig-spacing-8) + env(safe-area-inset-bottom))}"
       ".kaisya-operations__main>h1{margin-bottom:0}.kaisya-operations__main>p{color:var(--hig-color-secondary-label)}"
       ".kaisya-section{margin-block:var(--hig-spacing-5)}.kaisya-section h2{font-size:var(--hig-text-title2-font-size);margin-bottom:var(--hig-spacing-3)}"
       ".kaisya-panel{background:var(--hig-color-system-background);border:1px solid var(--hig-color-separator);border-radius:var(--hig-radius-md);padding:var(--hig-spacing-5)}"
       ".ks-actions{display:flex;gap:var(--hig-spacing-3);flex-wrap:wrap}"
       ".kaisya-task-nav{display:flex;gap:var(--hig-spacing-3);flex-wrap:wrap;margin-block:var(--hig-spacing-5)}.kaisya-task-nav a{display:inline-flex;align-items:center;min-height:44px;padding:var(--hig-spacing-2) var(--hig-spacing-4);border:1px solid var(--hig-color-separator);border-radius:var(--hig-radius-md);background:var(--hig-color-system-background)}"
       ".ks-muted{color:var(--hig-color-secondary-label)}"
       ".dads-visually-hidden{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip-path:inset(50%);white-space:nowrap}.dads-visually-hidden:focus{position:static;width:auto;height:auto;clip-path:none}"
       "form{display:grid;gap:var(--hig-spacing-3);max-width:32rem}"
       "label{display:grid;gap:var(--hig-spacing-1)}"
       "input,select,textarea{font:inherit;min-height:44px;padding:var(--hig-spacing-2);border:1px solid var(--hig-color-separator);border-radius:var(--hig-radius-sm)}"
       ".kaisya-panel button{min-height:44px}"
       "details{margin-block:var(--hig-spacing-3)}summary{cursor:pointer;min-height:44px;align-content:center}"
       "#owner-workspace[hidden]{display:none!important}"
       "@media(max-width:40rem){.kaisya-operations__main{padding:var(--hig-spacing-3)}.kaisya-panel{padding:var(--hig-spacing-4)}.kaisya-panel button{min-height:48px}}"))

(defn- dds-css [] (slurp "resources/jp_go_dds/dds.css"))

(defn render []
  (dds-page/->page
   {:title "kaisya · 会社の仕事場"
    :description "Gftd Japan の会計、勤怠、台帳"
    :lang "ja" :css "" :dark? true :dark-source (dds-css) :dark-inline? false
    :head (conj (dds-theme/head {:stylesheet "/css/kaisya-operations.css"})
                [:script {:type "module" :src "/js/kaisya-operations.js"}])}
   [:a {:class "dads-visually-hidden" :href "#main"} "本文へ"]
   (view)))

(defn -main []
  (let [page (render)]
    (io/make-parents "public/css/kaisya-operations.css")
    (spit "public/css/kaisya-operations.css" (str (dds-theme/stylesheet (dds-css)) "\n" app-css))
    (doseq [[filename script] dds-theme/scripts]
      (spit (str "public/js/" filename) script))
    (io/make-parents "public/operations.html")
    (spit "public/operations.html" page)
    (println "wrote cloud-kotoba-dds operations assets")))
