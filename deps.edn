{:paths ["src" "resources" "build/cljs"]

 ;; The kotoba-ui stack is this repository's only runtime dependency, and it is
 ;; the whole reason the portal exists as code rather than as a screenshot: the
 ;; office console (`cloud-itonami/lawfirm`) and this portal render from the
 ;; same design system, so a 弁護士 moving between them is not learning two
 ;; products.
 ;;
 ;; shitsuke / liquid-glass-ui / css / html are declared at the top level on
 ;; purpose — kotoba-ui's own deps.edn references them by `:local/root` for
 ;; sibling-checkout development, which does not resolve for a git consumer.
 ;; Top-level coordinates win over transitive ones.
 :deps {
        io.github.kotoba-lang/cloud-kotoba-dds
        {:git/url "https://github.com/kotoba-lang/cloud-kotoba-dds.git"
         :git/sha "22cefcd01652a84a6b7c6bfb0ca6f0a945aa63db"}
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.jpGoDigitalDesignSystem"}
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.io"}
        ;; kotoba.pprint replaced clojure.pprint here (2026-09-24): the same
        ;; bytes (cljs.pprint transcribed). An explicit floor; tools.deps takes the
        ;; NEWEST sha it is shown.
        io.github.kotoba-lang/pprint
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.pprint"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/kotoba-ui
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.kotobaUi"}
        io.github.kotoba-lang/appkit
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.appkit"}
        io.github.kotoba-lang/shitsuke
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.shitsuke"}
        io.github.kotoba-lang/liquid-glass-ui
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.liquidGlassUi"}
        io.github.kotoba-lang/css
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.css"}
        io.github.kotoba-lang/html
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.html"}
        io.github.kotoba-lang/webauthn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.webauthn"}
        io.github.kotoba-lang/org-chainagnostic-cacao
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/org.chainagnostic.cacao"}}

 :aliases
 {:cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      thheller/shadow-cljs {:mvn/version "2.28.20"}}}
  ;; clj-kondo from deps (no binary); errors fail.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}

  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      ;; Test-time only, and deliberately so. The portal must
                      ;; not depend on a practice at runtime — it renders plain
                      ;; data and any practice actor can supply it. But a
                      ;; contract nobody checks is a comment, so the suite
                      ;; asserts that what `lawfirm.projection/practice-summary`
                      ;; actually emits satisfies `kaisya.contract`.
                      io.github.cloud-itonami/lawfirm
                      {:git/url "https://github.com/cloud-itonami/lawfirm.git"
                       :git/sha "eb816888680868edb319446e3c37953a808e6a7b"}
                      io.github.kotoba-lang/design-quality
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.designQuality"}}
         :main-opts ["-m" "cognitect.test-runner"]}

  ;; kbb -M:emit-processes -> resources/kaisya/processes.edn
  ;; Generated from bpmn/*.bpmn. Never hand-edited.
  :emit-processes {:main-opts ["-m" "kaisya.bpmn"]}

  ;; kbb -M:render-console [out-file] -> docs/samples/kaisya-console.html
  :render-console {:main-opts ["-m" "kaisya.render-console"]}
  :render-operations {:main-opts ["-m" "kaisya.operations-page"]}
  :mirror-cljk {:main-opts ["-m" "kaisya.mirror-cljk"]}}}
