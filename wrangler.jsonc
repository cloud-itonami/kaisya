{
  "name": "cloud-itonami-kaisya",
  "main": "dist/edge/kaisya-edge-core.js",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*"]
  },
  "d1_databases": [{
    "binding": "KAISYA_DB",
    "database_name": "cloud-itonami-kaisya-operations",
    "database_id": "3ec69c88-8422-40ec-aa9c-258ef8c61ab6",
    "migrations_dir": "migrations"
  }],
  "routes": [
    {
      "pattern": "kaisya.itonami.cloud",
      "custom_domain": true
    },
    {
      "pattern": "kaisya.itonami.app",
      "custom_domain": true
    },
    {
      "pattern": "kaisya.itonami.app/*",
      "zone_name": "itonami.app"
    }
  ]
}
